{
	"name": "smartmirrordisplay",
	"version": "1.0.0",
	"description": "A MagicMirror derivative done as an personal project with new features",
	"main": "dist/js/index.js",
	"scripts": {
		"test": "jest",
		"prebuild": "find configs -name 'index.html' -delete",
		"build:server": "tsc -p tsconfig.json && cp -r js/db/migrations dist/js/db/migrations",
		"build:client": "esbuild js/clientMain.ts --bundle --outfile=dist/client/client.bundle.js --platform=browser --target=es2020",
		"build": "npm run build:server && npm run build:client",
		"typecheck:client": "tsc -p tsconfig.client.json",
		"server": "node dist/js/index.js",
		"mirrorClient": "node_modules/.bin/electron dist/js/electron.js",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:generate": "drizzle-kit generate",
		"postdb:generate": "cp -r js/db/migrations dist/js/db/migrations",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"client:config": "bash scripts/client-config.sh"
	},
	"author": "Dalibor Peňas",
	"license": "MIT",
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"electron": "^31.3.1",
		"envsub": "^4.1.0",
		"express": "^4.19.2",
		"express-ipfilter": "^1.3.2",
		"helmet": "^7.1.0",
		"ics-filter": "^1.0.5",
		"lodash": "^4.17.21",
		"moment": "^2.30.1",
		"moment-timezone": "^0.6.3",
		"node-ical": "^0.27.1",
		"socket.io": "^4.7.5",
		"socket.io-client": "^4.8.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.24",
		"@types/node": "^25.9.1",
		"@types/supertest": "^7.2.1",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.0",
		"jest": "^30.5.0",
		"jest-environment-jsdom": "^30.5.1",
		"prettier": "^3.9.6",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.12",
		"typescript": "^6.0.3"
	}
}
